generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  LANDLORD
  APPLICANT
  TEAM_MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Only set for credentials-based accounts; null for OAuth-only users.
  passwordHash String?

  role UserRole @default(LANDLORD)

  accounts Account[]
  sessions Session[]

  // Properties this user owns as a landlord. A TEAM_MEMBER's access to a
  // landlord's properties is deferred to a future PropertyMember-style join
  // model — not needed for the Phase 1 skeleton.
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Standard Auth.js (NextAuth) adapter models — required by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Property portfolio
// ---------------------------------------------------------------------------

model Property {
  id String @id @default(cuid())

  landlordId String
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  name         String? // optional nickname, e.g. "The Lawrenceville rowhouse"
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  // Cross street or address for a rear alley/service street, if this
  // property has one — landlord-entered since there's no reliable way to
  // detect it automatically. Powers a second "alley" Street View link on
  // the public listing, alongside the front-address one.
  alleyAddress String?

  // Drives the lead-paint disclosure gate: any property with buildYear < 1978
  // requires the Title X disclosure workflow before a lease is signed.
  buildYear Int

  // Narrative about the location/walkability — shared across every unit at
  // this address, so it lives here rather than being duplicated per Listing.
  neighborhoodBlurb String?

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

enum ParkingType {
  GARAGE_ATTACHED
  GARAGE_LOT
  COVERED_LOT
  STREET
  SURFACE_LOT
  OTHER
  NONE
}

model Unit {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // e.g. "Unit A", "Carriage House", "Attic Suite" — not a rigid unit number.
  name String

  rentAmountCents Int?
  bedrooms        Float? // float to allow non-conforming counts (e.g. 1.5)
  bathrooms       Float?
  squareFeet      Int?

  // Flexible room-by-room breakdown for character layouts that don't fit a
  // bed/bath grid (converted attic, non-conforming bedroom, etc). Shape is
  // an array of { name, type, notes } objects, validated in the app layer.
  rooms Json?

  // Freeform description of layout quirks, shown alongside `rooms`.
  layoutNotes String?

  // Fields below mirror the Zillow Rental Listing feed's single-unit schema,
  // so a future syndication export doesn't require a data-model rewrite.
  dateAvailable  DateTime?
  isFurnished    Boolean?
  smokingAllowed Boolean?
  parkingType    ParkingType?

  amenities   Amenity[]
  petPolicies PetPolicy[]
  fees        Fee[]
  utilities   Utility[]

  listing Listing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

enum AmenityCategory {
  AMENITY
  APPLIANCE
}

// A single amenity or appliance tag, e.g. "Dishwasher", "Pool", "In-unit
// laundry". Free-text rather than a fixed enum — both are open-ended, and
// this mirrors Zillow's own tag-based (not rigid-column) representation.
// `category` just splits the same free-text tag list into the two sections
// a listing page shows separately ("Appliances Included" vs "Amenities").
model Amenity {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  label    String
  category AmenityCategory @default(AMENITY)

  createdAt DateTime @default(now())

  @@map("amenities")
}

enum UtilityType {
  WATER
  GAS
  ELECTRIC
  TRASH
  SEWER
  INTERNET
  CABLE
  OTHER
}

// One row per utility that's relevant to a unit; a missing type means "not
// applicable" rather than "tenant pays". `included` is who pays: true means
// it's rolled into rent, false means the tenant sets it up themselves.
model Utility {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type     UtilityType
  included Boolean

  createdAt DateTime @default(now())

  @@unique([unitId, type])
  @@map("utilities")
}

enum PetType {
  DOGS
  CATS
  BIRDS
  REPTILES
  FISH
  OTHER
}

enum PetSize {
  SMALL
  LARGE
}

model PetPolicy {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  petType PetType
  petSize PetSize?
  allowed Boolean

  createdAt DateTime @default(now())

  @@map("pet_policies")
}

enum FeeType {
  SECURITY_DEPOSIT
  APPLICATION_FEE
  PET_RENT
  PET_DEPOSIT
  PET_FEE
  PARKING_FEE
  PARKING_PERMIT
  STORAGE_FEE
  SEWER_FEE
  GARBAGE_FEE
  OTHER
}

enum FeeTiming {
  MOVE_IN
  AT_APPLICATION
  MONTHLY
  ONE_TIME_OTHER
  RECURRING_OTHER
}

enum FeeRequirement {
  MANDATORY
  OPTIONAL
  SITUATIONAL
}

enum FeeRefundable {
  REFUNDABLE
  NON_REFUNDABLE
}

model Fee {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type        FeeType
  amountCents Int? // flat amount; null when described in `description` instead
  description String? // free text, used for OTHER / situational fees
  timing      FeeTiming
  requirement FeeRequirement @default(MANDATORY)
  refundable  FeeRefundable?

  createdAt DateTime @default(now())

  @@map("fees")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Listing {
  id String @id @default(cuid())

  unitId String @unique
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  headline String?

  // Short teaser shown in search results, distinct from the full narrative
  // below (mirrors Zillow's separate previewMessage/description fields).
  previewMessage String?

  // Narrative/story text — first-class field, not an afterthought.
  story String

  // Free text, e.g. "12 Months", "Month-to-month" — kept loose rather than
  // a rigid enum since lease terms vary more than a fixed list captures.
  leaseTerm String?

  virtualTourUrl String?

  // Stubbed as plain URLs for now rather than an upload pipeline — swap for
  // real photo storage (R2/S3) without touching anything that reads these.
  heroPhotoUrl String?
  floorPlanUrl String?

  status      ListingStatus @default(DRAFT)
  publishedAt DateTime?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listings")
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

// An inquiry submitted from a public listing page. Intentionally has no
// landlordId of its own — ownership is always derived through
// listing -> unit -> property, same as every other unit-scoped record.
model Lead {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name    String
  email   String
  phone   String?
  message String?

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  @@map("leads")
}
