# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Postgres connection string. Matches docker-compose.yml by default.
DATABASE_URL="postgresql://brickandbeam:brickandbeam@localhost:5432/brickandbeam"

# Auth.js secret used to sign/encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=""

# Base URL of the app. Used by Auth.js for callback URLs.
AUTH_URL="http://localhost:3000"

# Mapbox public token, used client-side for address autocomplete on the
# property form. Free tier: 100k requests/month, no billing required.
# Get one at https://console.mapbox.com/account/access-tokens/ (the
# default public token works) — safe to expose in the browser, but still
# gitignored here since it's tied to your account's usage quota. Without
# it the address field just falls back to a plain text input.
NEXT_PUBLIC_MAPBOX_TOKEN=""
